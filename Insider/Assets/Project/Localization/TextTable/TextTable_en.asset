      Terget
      Amount{3}'
    m_Metadata:
      m_Items:
      - rid: 1408601354238427151
  - m_Id: 386389478916096
    m_Localized: They are getting closer...
    m_Metadata:
      m_Items: []
  - m_Id: 386403605331968
    m_Localized: Brace yourself...
    m_Metadata:
      m_Items: []
  - m_Id: 386488225415168
    m_Localized: Spread and consume everything in your path
    m_Metadata:
      m_Items: []
  - m_Id: 386924865044480
    m_Localized: The swarm grows stronger!
    m_Metadata:
      m_Items: []
  - m_Id: 386975540625408
    m_Localized: Wave
    m_Metadata:
      m_Items: []
  - m_Id: 387345213997056
    m_Localized: Nothing remains...
    m_Metadata:
      m_Items: []
  - m_Id: 387372502138880
    m_Localized: You have consumed all
    m_Metadata:
      m_Items: []
  - m_Id: 387399517650944
    m_Localized: in your path
    m_Metadata:
      m_Items: []
  - m_Id: 393364350615552
    m_Localized: Pause
    m_Metadata:
      m_Items: []
  - m_Id: 393523235045376
    m_Localized: Resume
    m_Metadata:
      m_Items: []
  - m_Id: 393789099393024
    m_Localized: Main Menu
    m_Metadata:
      m_Items: []
  - m_Id: 393990711197696
    m_Localized: Music
    m_Metadata:
